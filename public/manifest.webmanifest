{
  "id": "/",
  "name": "SplitIt",
  "short_name": "SplitIt",
  "description": "Split group expenses without the spreadsheet.",
  "start_url": "/groups",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0f1614",
  "theme_color": "#0f1614",
